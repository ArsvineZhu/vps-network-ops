{
  "mode": "rule",
  "log-level": "warning",
  "ipv6": false,
  "listeners": [
    {
      "name": "reality-in",
      "type": "vless",
      "listen": "0.0.0.0",
      "port": 8443,
      "users": [
        {
          "username": "owner",
          "uuid": "REPLACE_WITH_RANDOM_UUID",
          "flow": "xtls-rprx-vision"
        }
      ],
      "reality-config": {
        "dest": "REPLACE_WITH_VERIFIED_TARGET:443",
        "server-names": ["REPLACE_WITH_VERIFIED_SNI"],
        "private-key": "REPLACE_WITH_X25519_PRIVATE_KEY",
        "short-id": ["REPLACE_WITH_HEX_SHORT_ID"]
      }
    }
  ],
  "rules": ["MATCH,DIRECT"]
}
