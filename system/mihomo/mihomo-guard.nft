# Replace MIHOMO_UID, VPS_IPV4, LISTEN_PORT and SUBSCRIPTION_PORT before loading.
# Own-table replacement in one nft transaction. Never flush ruleset.
add table inet mihomo_guard
 delete table inet mihomo_guard
 table inet mihomo_guard {
 set blocked_v4 {
 type ipv4_addr
 flags interval
 auto-merge
 elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10,
 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24,
 192.0.2.0/24, VPS_IPV4/32, 192.88.99.0/24, 192.168.0.0/16,
 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
 224.0.0.0/4, 240.0.0.0/4 }
 }
 chain guard {
 meta nfproto ipv6 counter drop
 ct direction reply ct state established tcp sport LISTEN_PORT counter return
 oifname "lo" ip daddr 127.0.0.53 udp dport 53 counter return
 oifname "lo" ip daddr 127.0.0.53 tcp dport 53 counter return
 meta nfproto ipv4 ct direction reply ct state established udp sport 8443 counter return
 meta nfproto ipv4 ct direction reply ct state established tcp sport 9444 counter return
 oifname "tfp-win0" ip daddr 10.203.1.2 tcp dport 1080 counter return comment "tcpfp-test:windows"
 oifname "tfp-ios0" ip daddr 10.203.2.2 tcp dport 1080 counter return comment "tcpfp-test:ios"
 ip daddr VPS_IPV4 tcp dport SUBSCRIPTION_PORT counter return comment "subscription"
 ip daddr @blocked_v4 counter drop
 fib daddr type { local, broadcast, multicast } counter drop
 oifname "lo" counter drop
 meta nfproto ipv4 meta l4proto { tcp, udp } counter return
 counter drop
 }
 chain output {
 type filter hook output priority 10; policy accept;
 meta skuid MIHOMO_UID counter jump guard
 }
 }
