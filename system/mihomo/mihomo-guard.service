[Unit]
Description=Private Mihomo egress guard
After=ufw.service nftables.service
Before=mihomo.service
[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/nftables.d/mihomo-guard.nft
ExecReload=/usr/sbin/nft -f /etc/nftables.d/mihomo-guard.nft
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
