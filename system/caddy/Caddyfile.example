{
	admin off
	auto_https off
}

https://REPLACE_WITH_SUBSCRIPTION_DOMAIN:9443 {
	tls /etc/caddy/certs/REPLACE_WITH_DOMAIN/current/fullchain.pem /etc/caddy/certs/REPLACE_WITH_DOMAIN/current/key.pem
	# Each physical device has one private URL. User-Agent chooses only
	# its default fingerprint profile; all variants retain that device's credentials.
	@device_subscription {
		path_regexp device_subscription ^/s/([A-Za-z0-9_-]{43})[.]yaml$
		method GET HEAD
	}
	@apple_subscription header_regexp User-Agent "(?i)(darwin|iphone|ipad|macintosh|mac os x|cfnetwork)"
	@win_subscription {
		header_regexp User-Agent "(?i)(windows|win64|clash-verge/)"
		not header_regexp User-Agent "(?i)(darwin|iphone|ipad|macintosh|mac os x|cfnetwork)"
	}
	handle @device_subscription {
		header Cache-Control "no-store"
		header Referrer-Policy "no-referrer"
		header Vary "User-Agent"
		header Profile-Update-Interval "24"
		handle @apple_subscription {
			rewrite * /{re.device_subscription.1}.Apple.yaml
			root * /srv/vps-subscriptions
			file_server
		}
		handle @win_subscription {
			rewrite * /{re.device_subscription.1}.Windows.yaml
			root * /srv/vps-subscriptions
			file_server
		}
		handle {
			rewrite * /{re.device_subscription.1}.yaml
			root * /srv/vps-subscriptions
			file_server
		}
	}
	@rule_resources {
		method GET HEAD
		path /rules/MetaCubeX/meta-rules-dat/* /rules/VPSDance/ai-proxy-rules/* /rules/ACL4SSR/ACL4SSR/* /rules/Loyalsoldier/clash-rules/*
	}
	handle @rule_resources {
		uri strip_prefix /rules
		reverse_proxy https://raw.githubusercontent.com {
			header_up -Cookie
			header_up -Authorization
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
		}
	}
	handle {
		respond 404
	}
}
