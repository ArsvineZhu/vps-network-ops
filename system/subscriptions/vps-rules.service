[Unit]
Description=Apply shared subscription rules

[Service]
Type=oneshot
UMask=0077
Environment=PYTHONNOUSERSITE=1
UnsetEnvironment=PYTHONPATH PYTHONHOME
ExecStart=/usr/local/bin/vps-ops subscription apply --policy /etc/vps-rules/rules.yaml --directory /srv/vps-subscriptions
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/vps-subscriptions
