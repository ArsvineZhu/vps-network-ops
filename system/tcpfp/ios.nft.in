table inet tcpfp_backend {
 set blocked_v4 { type ipv4_addr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, @PUBLIC_IPV4@/32, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 }; }
 chain input { type filter hook input priority 10; policy drop;
  meta nfproto ipv6 drop
  ct direction reply ct state established,related accept
  iifname "e0" ip saddr 10.203.2.1 tcp dport 1080 accept
 }
 chain output { type filter hook output priority 10; policy drop;
  meta nfproto ipv6 drop
  ct direction reply ct state established tcp sport 1080 accept
  oifname "e0" ip daddr 1.1.1.1 udp dport 53 accept
  oifname "e0" ip daddr 1.1.1.1 tcp dport 53 accept
  ip daddr @blocked_v4 counter drop comment "tcpfp-test:private"
  fib daddr type { local, broadcast, multicast } drop
  oifname "lo" drop
  meta nfproto ipv4 meta l4proto tcp accept
 }
}
