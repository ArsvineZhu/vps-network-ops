table inet tcpfp_test {
 set blocked_v4 { type ipv4_addr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, @PUBLIC_IPV4@/32, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 }; }
 chain input { type filter hook input priority -5; policy accept;
  iifname { "tfp-win0", "tfp-ios0" } ct direction reply ct state established,related accept
  iifname { "tfp-win0", "tfp-ios0" } counter drop
 }
 chain forward { type filter hook forward priority -5; policy accept;
  iifname { "tfp-win0", "tfp-ios0" } meta nfproto ipv6 drop
  iifname "tfp-win0" ip saddr != 10.203.1.2 drop
  iifname "tfp-ios0" ip saddr != 10.203.2.2 drop
  iifname { "tfp-win0", "tfp-ios0" } ip daddr @blocked_v4 counter drop
  iifname { "tfp-win0", "tfp-ios0" } oifname != "@WAN@" drop
  iifname { "tfp-win0", "tfp-ios0" } meta l4proto tcp accept
  iifname { "tfp-win0", "tfp-ios0" } ip daddr 1.1.1.1 udp dport 53 accept
  iifname { "tfp-win0", "tfp-ios0" } drop
  oifname { "tfp-win0", "tfp-ios0" } iifname "@WAN@" ct direction reply ct state established,related accept
  oifname { "tfp-win0", "tfp-ios0" } drop
 }
}
table ip tcpfp_test_nat {
 chain postrouting { type nat hook postrouting priority srcnat; policy accept;
  oifname "@WAN@" ip saddr { 10.203.1.2, 10.203.2.2 } masquerade
 }
}
